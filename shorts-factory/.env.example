# 로컬 실행용 환경변수.
#
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다.
#   cp .env.example .env
#
# 값은 채팅에 붙여넣지 않는다. 각 서비스 화면에서 직접 복사해 이 파일에만 넣는다.

# ─── 필수 ─────────────────────────────────────────────────────────

# Supabase 프로젝트. 대시보드 → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API. console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ─── 로컬에서만 의미가 있는 것 ────────────────────────────────────
#
# 서버(GitHub Actions)에서는 알리·1688·타오바오가 데이터센터 IP 차단에 걸려
# 소재 수집이 통째로 막혔다(실측: 상세 26번 열어 0번). 가정용 IP 에서는 열린다.
# 로컬 실행의 존재 이유가 이것이다.
#
# 브라우저를 눈에 보이게 띄운다. 캡차가 뜨면 사람이 한 번 풀어주면 된다.
# (변수 이름이 HEADLESS 가 아니라 HEADFUL 이다 — lib/browser.ts 가 그렇게 읽는다)
HEADFUL=true

# 인스타 릴스 발굴용 로그인 세션 (선택).
# 없어도 돈다 — 실측에서 **비로그인이 오히려 더 잘 됐다**(비로그인 12건 / 세션 0건).
# 다만 조회수는 로그인해야 읽힌다. 둘을 동시에 갖기는 아직 못 했다.
#   npm run capture instagram   으로 만든다
INSTAGRAM_STORAGE_STATE=

# ─── 나레이션 ─────────────────────────────────────────────────────
#
# 기본은 edge-tts 다. 키도 가입도 결제도 필요 없다.
# 타입캐스트는 무료 계정이 403 UNUSUAL_ACTIVITY_DETECTED 로 막혔다(실측).
# 유료 플랜을 결제한 뒤에만 아래 두 줄이 의미가 있다.
TTS_PROVIDER=edge
# TYPECAST_API_TOKEN=

# ─── 업로드·링크 (아직 검증 안 됨) ───────────────────────────────
#
# 셀렉터를 한 번도 실물로 확인하지 못했다. 켜기 전에 한 채널씩 확인한다.
# NAVER_STORAGE_STATE=
# TIKTOK_STORAGE_STATE=
# INPOCK_HANDLE=
