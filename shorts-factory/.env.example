# 로컬에서 돌릴 때 쓰는 값들.
#
# 쓰는 법: 이 파일을 복사해서 이름을 .env 로 바꾸고, = 뒤에 값을 채우세요.
#
#   cp .env.example .env
#
# .env 는 git 에 올라가지 않습니다(.gitignore 에 있음). 값을 채팅이나 커밋에
# 붙여넣지 마세요 — 한 번 올라가면 지워도 기록에 남습니다.
#
# 전부 채울 필요는 없습니다. 하려는 일에 필요한 것만 있으면 됩니다.

# ───────────────────────────────────────────────────────────
# 소재 링크 수확에 필요한 것 (npm run links harvest)
# ───────────────────────────────────────────────────────────

# Supabase 대시보드 → 프로젝트 선택 → 좌측 Settings(톱니) → API
#   Project URL 을 그대로 복사
SUPABASE_URL=

#   같은 화면의 service_role 키. ⚠️ 이건 관리자 키입니다.
#   공개 저장소·채팅·스크린샷 어디에도 올리지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────────────────────────────────────────────────
# 영상 제작까지 돌릴 때 추가로 필요한 것
# ───────────────────────────────────────────────────────────

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# typecast.ai → 로그인 후 좌측 메뉴 API
TYPECAST_API_TOKEN=

# ───────────────────────────────────────────────────────────
# 로그인 세션 (npm run capture 가 만들어 줍니다. 손으로 채우지 마세요)
# ───────────────────────────────────────────────────────────

# npm run capture xhs / ali / tiktok / naver / inpock 을 돌리면
# .sessions/ 폴더에 파일이 생기고, 그 내용을 여기 넣으라고 안내가 나옵니다.
XIAOHONGSHU_STORAGE_STATE=
ALI1688_STORAGE_STATE=
TIKTOK_STORAGE_STATE=
NAVER_STORAGE_STATE=
INPOCK_STORAGE_STATE=

# ───────────────────────────────────────────────────────────
# 선택
# ───────────────────────────────────────────────────────────

# 수확할 때 검색 결과를 몇 번 스크롤할지 (기본 10). 올리면 더 모이지만
# 그만큼 오래 머물러 차단 위험이 늡니다.
# HARVEST_SCROLL_ROUNDS=10

# true 면 자동화가 브라우저를 눈에 보이게 띄웁니다. 뭔가 안 될 때 확인용.
# HEADFUL=true
